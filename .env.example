# Vercel frontend setting; point this to the deployed Render API in production.
VITE_API_URL=http://localhost:8000

# Render API settings. Never put these in Vite/browser variables.
MONGODB_URI=
MONGODB_DATABASE=aaro
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173
AUTH_SECRET=
ADMIN_ID=
ADMIN_PASSWORD_HASH=
GITHUB_ACTIONS_TOKEN=
GITHUB_SYNC_REPOSITORY=tashfinn/AARO
GITHUB_SYNC_WORKFLOW=shopbase-sync.yml

# GitHub Actions importer settings. Save SHOPBASE_SESSION_COOKIE in the
# repository's Actions secrets; it is not needed by the public storefront.
SHOPBASE_SESSION_COOKIE=
AARO_MARKUP_PERCENT=20
SHOPBASE_REQUEST_DELAY_SECONDS=0.35
SHOPBASE_DETAIL_REFRESH_DAYS=7
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MIRROR_IMAGES=false
